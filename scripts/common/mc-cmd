#!/usr/bin/env python3
# Schickt einen Befehl an die Server-Konsole - per RCON, ohne den Server von Hand
# starten zu muessen. Liest Port und Passwort aus server.properties.
# Benutzung (als root):  mc-cmd "op SpielerName"
#                        mc-cmd gamerule players_sleeping_percentage 0
import socket
import struct
import sys

PROPS = "/home/minecraft/paper/server.properties"

props = {}
with open(PROPS, encoding="utf-8") as f:
    for line in f:
        if "=" in line and not line.startswith("#"):
            k, v = line.strip().split("=", 1)
            props[k] = v

if props.get("enable-rcon") != "true" or not props.get("rcon.password"):
    sys.exit("RCON ist aus: enable-rcon=true und rcon.password in server.properties setzen, Server neu starten.")


def packet(req_id, ptype, body):
    data = struct.pack("<ii", req_id, ptype) + body.encode("utf-8") + b"\x00\x00"
    return struct.pack("<i", len(data)) + data


def receive(sock):
    length = struct.unpack("<i", sock.recv(4))[0]
    data = b""
    while len(data) < length:
        data += sock.recv(length - len(data))
    req_id = struct.unpack("<i", data[:4])[0]
    return req_id, data[8:-2].decode("utf-8", "replace")


with socket.create_connection(("127.0.0.1", int(props.get("rcon.port", "25575"))), timeout=10) as s:
    s.sendall(packet(1, 3, props["rcon.password"]))
    if receive(s)[0] == -1:
        sys.exit("RCON-Login fehlgeschlagen (Passwort in server.properties pruefen).")
    s.sendall(packet(2, 2, " ".join(sys.argv[1:])))
    print(receive(s)[1])
