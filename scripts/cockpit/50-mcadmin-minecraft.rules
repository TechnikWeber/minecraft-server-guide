// Cockpit-Benutzer "mcadmin" darf nur den Minecraft-Dienst starten, stoppen
// und neu starten und das Hilfsprogramm mc-admin per pkexec ausfuehren (prueft
// selbst jede Eingabe) - sonst nichts. Ziel: /etc/polkit-1/rules.d/ (Rechte 644!).
polkit.addRule(function(action, subject) {
  if (subject.user != "mcadmin") {
    return polkit.Result.NOT_HANDLED;
  }
  if (action.id == "org.freedesktop.systemd1.manage-units") {
    var unit = action.lookup("unit"), verb = action.lookup("verb");
    if (unit == "minecraft-paper.service" && (verb == "start" || verb == "stop" || verb == "restart")) {
      return polkit.Result.YES;
    }
    return polkit.Result.NO;
  }
  if (action.id == "org.freedesktop.policykit.exec") {
    return action.lookup("program") == "/usr/local/sbin/mc-admin" ? polkit.Result.YES : polkit.Result.NO;
  }
});
